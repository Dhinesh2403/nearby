# ─────────────────────────────────────────────────────────────
# NearBy Backend — Environment Variables
# Copy this to .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ── MongoDB — one database per environment ─────────────────────
#
#  Development  (local — run: mongod --dbpath ./data)
MONGO_URI=mongodb://localhost:27017/nearby_dev
#
#  Staging  (local or Atlas staging cluster)
# MONGO_URI=mongodb://localhost:27017/nearby_staging
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/nearby_staging
#
#  Production  (Atlas production cluster)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/nearby_prod
#
#  Seed commands after setting MONGO_URI:
#    npm run seed:dev      → 8 users + 6 providers + sample reviews
#    npm run seed:staging  → 4 users + 2 providers + 1 review
#    npm run seed:prod     → 3 hidden demo accounts (isDemo:true, invisible to real users)

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=b3514b49224b158b50925b1d105beff688311c756a719022b343007b792983d9ae26dbe37a746488d7d91eb37428a57ac5e9aa3edeedfbcc54b26a8a3cf555bd
JWT_REFRESH_SECRET=04ae280cc5091bc011d9ee55454638256cf3d14208d643ad199138e9d7135a4f536ae419074d59450d09197b8244cfcaf217211ccd257e6ec14921ce99628501
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# Frontend origin (for CORS)
CLIENT_URL=http://localhost:4200

# ── ADMIN (created on server start; no self-registration) ──────
ADMIN_EMAIL=admin@nearby.app
ADMIN_PASSWORD=change-me-strong-password
# ADMIN_PHONE=9000000099   # optional

# ── FIREBASE PHONE AUTH (server-side ID token verification) ────
# Option 1 — service-account JSON file (easiest for local dev):
#   Firebase console → Project settings → Service accounts →
#   "Generate new private key" → save as server/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Option 2 — inline credentials (easiest for hosted deploys):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

N8N_BOOKING_WEBHOOK_URL=https://app.n8n.cloud/webhook/booking-notification

# ── CLOUDINARY (image uploads) ─────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
