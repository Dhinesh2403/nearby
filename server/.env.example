# ─────────────────────────────────────────────────────────────
# NearBy Backend — Environment Variables
# Copy this to .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ── LOCAL MongoDB (default — no account needed) ───────────────
# Make sure MongoDB is running:  mongod --dbpath ./data
MONGO_URI=mongodb://localhost:27017/nearby

# ── OR Atlas (for production) ─────────────────────────────────
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/nearby

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=local_dev_secret_replace_before_production_deploy_abc123
JWT_REFRESH_SECRET=local_dev_refresh_secret_replace_before_production_xyz789
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional for local dev — upload returns placeholder if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (optional — emails are logged to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:4200
